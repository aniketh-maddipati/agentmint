                "type": "string"
              },
              "plan_id": {
                "type": "string"
              },
              "version": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "payer_name",
              "member_id",
              "plan_id",
              "dos",
              "version"
            ],
            "type": "object"
          },
          "documents": {
            "items": {
              "properties": {
                "content_hash": {
                  "type": "string"
