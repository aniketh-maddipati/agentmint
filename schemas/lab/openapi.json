                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "content_hash"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "rules": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "run_id": {
            "format": "uuid",
            "type": "string"
          },
          "service": {
            "properties": {
              "cpt": {
                "type": "string"
              },
              "diagnosis": {
                "type": "string"
              },
              "site": {
                "type": "string"
              },
              "version": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "cpt",
              "diagnosis",
              "site",
              "version"
            ],
            "type": "object"
          },
          "task_context": {
            "description": "Arbitrary JSON value"
          },
          "task_id": {
            "format": "uuid",
            "type": "string"
          },
          "task_purpose": {
            "enum": [
              "collect_missing_info",
              "benefits_verification",
              "clarify_bv",
              "collect_documentation",
              "review_packet",
              "submit_pa",
              "follow_up_status",
              "deliver_handoff",
              "appeal_preparation",
              "human_review",
              "manual_disposition"
            ],
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "task_id",
          "task_purpose",
          "task_context",
          "service",
          "coverage",
          "conversation",
          "documents",
          "allowed_evidence_ids",
          "allowed_tools",
          "rules"
        ],
        "title": "AssignedContext",
        "type": "object"
      },
      "EvalReport": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "live": {
            "type": "boolean"
          },
          "model_id": {
            "type": "string"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "output_type": {
            "type": "string"
          },
          "overall_passed": {
            "type": "boolean"
          },
          "repair_count": {
            "default": 0,
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "runner": {
            "default": "",
            "type": "string"
          },
          "scenario_id": {
            "type": "string"
          },
          "scores": {
            "items": {
              "properties": {
                "detail": {
                  "type": "string"
                },
                "dimension": {
                  "enum": [
                    "fact_extraction",
                    "uncertainty",
                    "tool_authority",
                    "workflow_disposition_hint"
                  ],
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                }
              },
              "required": [
                "dimension",
                "passed",
                "detail"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "tool_call_count": {
            "default": 0,
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "scenario_id",
          "model_id",
          "live",
          "scores",
          "overall_passed",
          "output_type",
          "notes"
        ],
        "title": "EvalReport",
        "type": "object"
      },
      "EvidenceBlob": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
