            "type": "string"
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "mode"
        ],
        "title": "AskPayerResponse",
        "type": "object"
      },
      "AssignedContext": {
