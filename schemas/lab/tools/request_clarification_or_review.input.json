{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "message": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "enum": [
        "unclear",
        "conflict",
        "injection",
        "malformed_payer",
        "other"
      ],
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "message",
    "reason"
  ],
  "title": "RequestClarificationRequest",
  "type": "object"
}
